# EditorConfig — 统一代码风格
# https://editorconfig.org

root = true

# 默认规则
[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

# Markdown
[*.md]
trim_trailing_whitespace = false

# JSON
[*.json]
indent_size = 2

# YAML
[*.{yml,yaml}]
indent_size = 2

# Python
[*.py]
indent_size = 4
max_line_length = 120

# Rust (Tauri)
[*.rs]
indent_size = 4

# Shell scripts
[*.{sh,bash}]
end_of_line = lf
indent_size = 2

# PowerShell
[*.ps1]
end_of_line = crlf
indent_size = 2
