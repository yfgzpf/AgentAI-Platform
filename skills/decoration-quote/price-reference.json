  "calculation_rules": {
    "地面损耗": "面积 × 1.05 (5%)",
    "墙面面积": "周长 × 层高2.8m × 0.85 (扣除门窗15%)",
    "乳胶漆面积": "地面面积 × 3.2 (墙面1+顶面1+墙面0.2损耗)",
    "防水面积": "地面 × 1.2 + 墙面高度 × 周长",
    "美缝米数": "地砖面积 × 对应系数",
    "踢脚线": "周长 × 1.05",
    "衣柜投影": "宽度(m) × 高度(m × (标准2.4m)",
    "橱柜地柜": "厨房周长 × 0.6 (一般地柜占周长60%)"
  }
