# ============================================
# AgentAI Platform — 环境变量模板
# ============================================
# 复制此文件为 .env 并填入实际值:
#   cp .env.example .env
#
# ⚠️  请勿将包含真实密钥的 .env 文件提交到 Git!
# ============================================

# ── Gateway 服务配置 ──────────────────────
PORT=3200
HOST=0.0.0.0
NODE_ENV=development
LOG_LEVEL=debug

# ── LLM Provider 密钥 (至少配置一个) ──────
# OpenAI
OPENAI_API_KEY=sk-your-openai-key-here
OPENAI_BASE_URL=https://api.openai.com/v1

# Anthropic Claude
ANTHROPIC_API_KEY=sk-ant-your-anthropic-key-here

# DeepSeek
DEEPSEEK_API_KEY=sk-your-deepseek-key-here

# AgentAI 自定义模型
AGENTAI_API_URL=https://api.agentai.example.com/v1
AGENTAI_API_KEY=sk-your-agentai-key-here

# ── 数据库配置 ────────────────────────────
DATABASE_URL=./data/agentai.db

# ── Redis (可选, 用于缓存和会话) ───────────
REDIS_URL=redis://localhost:6379

# ── 向量数据库 (可选, 用于语义记忆) ────────
VECTOR_DB_URL=http://localhost:8000
VECTOR_DB_TYPE=chroma  # chroma | milvus | qdrant

# ── MCP Server 配置 ───────────────────────
MCP_ENABLED=true
MCP_STDIO_SERVERS=[]

# ── QQ Bot 配置 ───────────────────────────
QQ_APP_ID=123456789
QQ_APP_TOKEN=your-qq-bot-token-here

# ── Telegram Bot (可选) ───────────────────
TG_BOT_TOKEN=your-tg-bot-token-here

# ── WeChat Work (可选) ────────────────────
WECOM_CORP_ID=your-corp-id
WECOM_AGENT_ID=1000001
WECOM_SECRET=your-wecom-secret

# ── 安全配置 ──────────────────────────────
JWT_SECRET=your-jwt-secret-at-least-32-chars
SESSION_SECRET=your-session-secret-at-least-32-chars
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# ── SkillOpt 配置 ─────────────────────────
SKILLOPT_ENABLED=true
SKILLOPT_CRON_SCHEDULE="0 2 * * *"  # 每天凌晨2点运行
SKILLOPT_ANTHROPIC_API_KEY=${ANTHROPIC_API_KEY}

# ── 多模态服务配置 ─────────────────────────
IMAGE_GEN_PROVIDER=dall-e           # dall-e | midjourney | stable-diffusion
IMAGE_GEN_API_KEY=

# TTS 提供商配置
TTS_PROVIDER=edge                   # edge | mimo | moss | openai | agnes
TTS_API_KEY=

# MiMo TTS (小米商业TTS，高品质)
MIMO_API_KEY=sk-your-mimo-key-here
MIMO_BASE_URL=https://api.xiaomimimo.com/v1
MIMO_MODEL=mimo-tts-v2.5

# ── 监控与遥测 (可选) ──────────────────────
TELEMETRY_ENABLED=false
SENTRY_DSN=
ANALYTICS_WRITE_KEY=

# ── Tauri 桌面端 (仅桌面端构建时需要) ───────
TAURI_SIGNING_PRIVATE_KEY_PASSWORD=
TAURI_UPDATEND_BASE_URL=https://updates.agentai.example.com
