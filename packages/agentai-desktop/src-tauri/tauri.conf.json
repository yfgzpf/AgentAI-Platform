{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "PulseFlow",
  "version": "0.1.0-alpha.1",
  "identifier": "com.pulseflow.platform",
  "build": {
    "frontendDist": "../../agentai-gui/dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "pnpm --filter @agentai/gui dev",
    "beforeBuildCommand": "powershell -ExecutionPolicy Bypass -File ./scripts/bundle-python.ps1 && pnpm --filter @agentai/gateway build && pnpm --filter @agentai/gui build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "PulseFlow",
        "width": 1200,
        "height": 800,
        "minWidth": 800,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false,
        "decorations": true,
        "transparent": false,
        "center": true,
        "titleBarStyle": "Visible"
      }
    ],
    "security": {
      "csp": "default-src 'self' ws: http://127.0.0.1:18789; script-src 'self' 'unsafe-inline' https://cdn.jsdelivr.net; style-src 'self' 'unsafe-inline' https://cdn.jsdelivr.net; img-src 'self' data: blob: https:; font-src 'self' data: https://cdn.jsdelivr.net; connect-src 'self' ws: http://127.0.0.1:18789 https://apihub.agnes-ai.com https://api.deepseek.com"
    },
    "trayIcon": {
      "id": "main-tray",
      "iconPath": "icons/icon.png",
      "iconAsTemplate": false,
      "tooltip": "PulseFlow Studio — 让智能体理解系统的生命状态"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "resources": [
      "../../agentai-gateway/dist/**/*",
      "resources/lite.html"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/256x256.png",
      "icons/icon.png"
    ],
    "category": "DeveloperTool",
    "shortDescription": "PulseFlow — 让智能体理解系统的生命状态",
    "longDescription": "PulseFlow — 让智能体理解系统的生命状态, 融合中医辨证思维的状态感知型智能体框架, 5+ 模型自由切换, 146+ 工具生态, 任务快照/恢复, 行业知识库, 多 Agent 协作, 跨会话进化, 望闻问切 · 因证施治 · 越用越懂你的 AI 工作伙伴",
    "publisher": "PulseFlow Team",
    "copyright": "© 2026 PulseFlow Team",
    "homepage": "https://github.com/pulseflow/platform",
    "windows": {
      "nsis": {
        "installerHooks": "nsis/installer-hooks.nsh",
        "displayLanguageSelector": false,
        "languages": ["SimpChinese", "English"],
        "installMode": "perMachine"
      }
    },
    "linux": {
      "deb": {
        "depends": []
      }
    },
    "macOS": {
      "frameworks": [],
      "minimumSystemVersion": "10.15"
    }
  },
  "plugins": {
    "updater": {
      "active": true,
      "dialog": true,
      "endpoints": [
        "https://updates.agentai.example.com/{{target}}-{{arch}}/{{current_version}}"
      ],
      "pubkey": "dW50cnVzdGVkLCBtYXJrZXQgcHVibGljIGtleSB0ZW1wbGF0ZS4gUmVwbGFjZSB3aXRoIHlvdXIgb3duIGdlbmVyYXRlZCBrZXkuIFJ1bjogdGF1cmkga2V5IHZlcmlmeSAtdyAuLi9zcmMtdGF1cmkvYXBwLmNlcnQgLWsgcHVia2V5"
    },
    "autostart": {
      "active": false
    }
  }
}
