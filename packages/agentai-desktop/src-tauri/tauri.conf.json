{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "PulseFlow",
  "version": "0.1.0",
  "identifier": "com.pulseflow.platform",
  "build": {
    "frontendDist": "../../agentai-gui/dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "pnpm --filter @agentai/gui dev",
    "beforeBuildCommand": "node scripts/build-for-desktop.mjs"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "PulseFlow",
        "width": 1200,
        "height": 800,
        "minWidth": 800,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false,
        "decorations": false,
        "transparent": true,
        "center": true,
        "titleBarStyle": "Overlay"
      }
    ],
    "security": {
      "csp": "default-src 'self' ws: http://127.0.0.1:18789; script-src 'self' 'unsafe-inline' 'unsafe-eval' https://cdn.jsdelivr.net; style-src 'self' 'unsafe-inline' https://cdn.jsdelivr.net; img-src 'self' data: blob: https: asset: http://asset.localhost; font-src 'self' data: https://cdn.jsdelivr.net; connect-src 'self' ws: ipc: http://127.0.0.1:18789 http://ipc.localhost https://apihub.agnes-ai.com https://api.deepseek.com https://mp.weixin.qq.com https://runware.ai https://volcengine.com https: https://api.weixin.qq.com https://github.com https://objects.githubusercontent.com https://api.github.com; worker-src 'self' blob:; frame-src 'self' https:"
    },
    "trayIcon": {
      "id": "main-tray",
      "iconPath": "icons/icon.png",
      "iconAsTemplate": false,
      "tooltip": "PulseFlow Studio — 让智能体理解系统的生命状态"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "resources": {
      "resources/gateway-dist-v2": "gateway-dist-v2",
      "resources/lite.html": "lite.html",
      "scripts/install-deps.bat": "scripts/install-deps.bat",
      "../../agentai-skills": "agentai-skills",
      "../../agentai-vscode/agentai-vscode-0.1.0-alpha.1.vsix": "agentai-vscode.vsix"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/256x256.png",
      "icons/icon.png",
      "icons/icon.ico"
    ],
    "category": "DeveloperTool",
    "shortDescription": "PulseFlow — 让智能体理解系统的生命状态",
    "longDescription": "PulseFlow — 让智能体理解系统的生命状态, 融合中医辨证思维的状态感知型智能体框架, 5+ 模型自由切换, 146+ 工具生态, 任务快照/恢复, 行业知识库, 多 Agent 协作, 跨会话进化, 望闻问切 · 因证施治 · 越用越懂你的 AI 工作伙伴",
    "publisher": "PulseFlow Team",
    "copyright": "© 2026 PulseFlow Team",
    "homepage": "https://github.com/pulseflow/platform",
    "windows": {
      "nsis": {}
    },
    "linux": {
      "deb": {
        "depends": []
      }
    },
    "macOS": {
      "frameworks": [],
      "minimumSystemVersion": "10.15"
    }
  },
  "plugins": {
    "updater": {
      "active": true,
      "endpoints": [
        "https://github.com/PulseFlowAI/pulseflow-platform/releases/latest/download/latest.json",
        "https://gitee.com/api/v5/repos/PulseFlowAI/pulseflow-platform/releases/latest"
      ],
      "dialog": true,
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEIwMTBDODFFNzk4QjdGQjUKUldTMWY0dDVIc2dRc05DRzdJVEhpbzhjWWgzR2RiZStKdFQ5eUFNY2dvZ3c0SkFIZ25ZWklqc1AK"
    }
  }
}
