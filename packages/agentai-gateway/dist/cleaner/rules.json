[
  {
    "id": "tmp-cache",
    "match": { "path": "**/tmp/**", "mtimeDaysAgo": ">1" },
    "action": "delete",
    "risk": "safe",
    "reason": "临时缓存文件,超过1天自动清理",
    "enabled": true
  },
  {
    "id": "cache-dirs",
    "match": { "path": "**/cache/**", "mtimeDaysAgo": ">7" },
    "action": "gzip-archive",
    "risk": "safe",
    "reason": "缓存目录,超过7天压缩归档",
    "enabled": true
  },
  {
    "id": "logs",
    "match": { "path": "**/*.log", "mtimeDaysAgo": ">30" },
    "action": "gzip-archive",
    "risk": "safe",
    "reason": "日志文件,超过30天压缩归档",
    "enabled": true
  },
  {
    "id": "audit-logs",
    "match": { "path": ".agentai/audit/**", "mtimeDaysAgo": ">14" },
    "action": "move-archive",
    "risk": "risky",
    "archiveDir": "~/.agentai/archive/audit",
    "reason": "审计日志,超过14天需确认后归档",
    "enabled": true
  },
  {
    "id": "memory-jsonl",
    "match": { "path": ".agentai/**/*.jsonl", "mtimeDaysAgo": ">90" },
    "action": "gzip-archive",
    "risk": "risky",
    "archiveDir": "~/.agentai/archive/memory",
    "reason": "记忆文件,超过90天需确认后压缩归档",
    "enabled": false
  },
  {
    "id": "digests",
    "match": { "path": ".agentai/digests/**", "mtimeDaysAgo": ">30" },
    "action": "gzip-archive",
    "risk": "safe",
    "archiveDir": "~/.agentai/archive/digests",
    "reason": "摘要文件,超过30天压缩归档",
    "enabled": true
  },
  {
    "id": "node-modules-cache",
    "match": { "path": "node_modules/.cache/**", "mtimeDaysAgo": ">1" },
    "action": "delete",
    "risk": "safe",
    "reason": "node_modules 缓存,超过1天自动清理",
    "enabled": true
  },
  {
    "id": "dist-builds",
    "match": { "path": "**/dist/**", "mtimeDaysAgo": ">90", "sizeBytes": ">1073741824" },
    "action": "delete",
    "risk": "risky",
    "reason": "构建产物,超过90天且大于1GB需确认删除",
    "enabled": false
  },
  {
    "id": "pycache",
    "match": { "path": "**/__pycache__/**", "mtimeDaysAgo": ">1" },
    "action": "delete",
    "risk": "safe",
    "reason": "Python 缓存,超过1天自动清理",
    "enabled": true
  },
  {
    "id": "npm-cache",
    "match": { "path": "**/.npm/**", "mtimeDaysAgo": ">14" },
    "action": "delete",
    "risk": "safe",
    "reason": "npm 缓存,超过14天自动清理",
    "enabled": true
  },
  {
    "id": "test-reports",
    "match": { "path": "**/test-results/**", "mtimeDaysAgo": ">3" },
    "action": "delete",
    "risk": "safe",
    "reason": "测试报告,超过3天自动清理",
    "enabled": true
  },
  {
    "id": "oversize-warn",
    "match": { "path": "**/*", "sizeBytes": ">536870912" },
    "action": "alert",
    "risk": "alert",
    "reason": "超过512MB的大文件告警",
    "enabled": true
  }
]
